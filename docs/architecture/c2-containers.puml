@startuml c2-containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Milkyway IDEA Plugin — C2 Containers

Person(dev, "Mobile Developer")

System_Ext(sys_ide, "IntelliJ Platform")
System_Ext(sys_gradle, "Gradle Build System")
System_Ext(sys_jcef, "JCEF (Chromium)")
System_Ext(sys_fs, "Filesystem")

System_Boundary(sys_milkyway, "Milkyway IDEA Plugin") {

    Container(cont_parser, "Parser / Resolver", "Kotlin (idea-plugin/resolver + gradle-plugin)", "Turns build.gradle.kts text (or Gradle model) into DependencyGraph. Two strategies: Regex, Gradle-task.")

    Container(cont_engine, "Graph Engine", "Kotlin (core/analyzer + core/shape + idea-plugin/feature)", "SCC (Tarjan), critical paths (topo DAG), articulation points, shape matching (cosine on layer profile), subgraph cut.")

    Container(cont_visualizer, "Visualizer", "Kotlin + JS (idea-plugin/editor + cytoscape + resources/web/*)", "Builds Cytoscape report, renders HTML, hosts JBCefBrowser inside the split-editor. ToolWindow variant available.")

    ContainerDb(cont_shared, "Shared Models", "Kotlin (core/models + core/mapper)", "DependencyGraph, DTOs (DependencyGraphDto, CytoscapeReportDto, Shape…), GraphDependencyMapper.")

    Container(cont_report_svc, "Report Service + Settings", "Kotlin (idea-plugin/MilkyWayReportService, settings)", "Caches latest cytoscape JSON on disk, propagates updates to tool window panel; PersistentStateComponent for user preferences.")
}

Rel(dev, sys_ide, "Opens *.gradle.kts, edits, triggers action")
Rel(sys_ide, cont_visualizer, "FileEditorProvider, Action, StartupActivity")
Rel(sys_ide, cont_report_svc, "Service lookup, PersistentStateComponent storage")

Rel(cont_visualizer, cont_parser, "Requests DependencyResolver.resolve()")
Rel(cont_parser, sys_fs, "Reads settings.gradle.kts / build.gradle.kts via VFS")
Rel(cont_parser, sys_gradle, "GradleDependencyResolver runs :milkywayDependencyGraph via ExternalSystemUtil + init-script")
Rel(sys_gradle, sys_fs, "PrintDependenciesTask writes DependencyGraphDto JSON to build/reports/milkyway/")
Rel(cont_parser, sys_fs, "Reads back Gradle-produced JSON")

Rel(cont_parser, cont_shared, "Produces DependencyGraph / uses GraphDependencyMapper")
Rel(cont_visualizer, cont_engine, "GraphCutter → ReportBuilder → analyzers")
Rel(cont_engine, cont_shared, "Consumes/produces DependencyGraph, emits CytoscapeReportDto")

Rel(cont_visualizer, sys_jcef, "JBCefBrowser.loadHTML(rendered template with report JSON)")
Rel(cont_visualizer, cont_report_svc, "update(json) on Analyze action; loadCached() on tool window open")
Rel(cont_report_svc, sys_fs, "Writes/reads cache under PathManager.getSystemDir()/milkyway/<hash>/")

SHOW_LEGEND()
@enduml
