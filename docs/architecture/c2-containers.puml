@startuml c2-containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Milkyway IDEA Plugin — C2 Containers

Person(dev, "Mobile Developer")

System_Ext(sys_ide, "IntelliJ Platform")
System_Ext(sys_gradle, "Gradle Build System")
System_Ext(sys_jcef, "JCEF (Chromium)")
System_Ext(sys_fs, "Filesystem")

System_Boundary(sys_milkyway, "Milkyway IDEA Plugin") {

    Container(cont_parser, "Parser / Resolver", "Kotlin (features/parser:api, features/parser:regex, plugins/idea-plugin/resolver, plugins/gradle-plugin)", "Turns build.gradle.kts text (or Gradle model) into DependencyGraph. Two strategies: Regex (RegexGradleParser + IJ adapter), Gradle-task. DependencyResolver interface lives in features/parser:api.")

    Container(cont_algorithm, "Algorithm Pipeline", "Kotlin (features/algorithm:api, :critical-path, :articulation-points, :shape-matching)", "Parallel GraphAnalyzer<R> pipeline via coroutines: SCC (Tarjan) → critical paths (topo DAG), articulation points, shape matching (cosine on layer profile). Each analyzer returns an AnalyzerResult; AnalysisPipeline aggregates into GraphAnalysisResult.")

    Container(cont_engine, "Graph Feature", "Kotlin (idea-plugin/feature)", "GraphCutter: BFS subgraph shrink from the currently-edited module. Runs before the algorithm pipeline.")

    Container(cont_visualizer, "Visualizer", "Kotlin + JS (visualizer:api, visualizer:cytoscape, web/*)", "CytoscapeVisualizer: renders GraphAnalysisResult → CytoscapeReportDto → embeds in HTML template ({{placeholders}}). Hosts JBCefBrowser inside split-editor and ToolWindow.")

    ContainerDb(cont_shared, "Shared Models", "Kotlin (core/models + core/mapper)", "DependencyGraph, Node, EdgeVisit, DependencyGraphDto, GraphDependencyMapper, MilkyWayConstants.")

    Container(cont_report_svc, "Report Service + Settings", "Kotlin (idea-plugin/MilkyWayReportService, settings)", "Caches latest rendered HTML on disk, propagates updates to tool window panel; PersistentStateComponent for user preferences.")
}

Rel(dev, sys_ide, "Opens *.gradle.kts, edits, triggers action")
Rel(sys_ide, cont_visualizer, "FileEditorProvider, Action, StartupActivity")
Rel(sys_ide, cont_report_svc, "Service lookup, PersistentStateComponent storage")

Rel(cont_visualizer, cont_parser, "DependencyResolver.resolve()")
Rel(cont_parser, sys_fs, "Reads settings.gradle.kts / build.gradle.kts via VFS")
Rel(cont_parser, sys_gradle, "GradleDependencyResolver runs :milkywayDependencyGraph via ExternalSystemUtil + init-script")
Rel(sys_gradle, sys_fs, "PrintDependenciesTask writes DependencyGraphDto JSON to build/reports/milkyway/")
Rel(cont_parser, sys_fs, "Reads back Gradle-produced JSON")

Rel(cont_parser, cont_shared, "Produces DependencyGraph / uses GraphDependencyMapper")
Rel(cont_visualizer, cont_engine, "GraphCutter.cut() → trimmed DependencyGraph")
Rel(cont_engine, cont_algorithm, "trimmed graph → AnalysisPipeline.run()")
Rel(cont_algorithm, cont_shared, "Consumes DependencyGraph; result types reference Node, Shape")
Rel(cont_algorithm, cont_visualizer, "GraphAnalysisResult → CytoscapeVisualizer.render()")

Rel(cont_visualizer, sys_jcef, "JBCefBrowser.loadHTML(full HTML from CytoscapeVisualizer)")
Rel(cont_visualizer, cont_report_svc, "update(html) on Analyze action; loadCached() on tool window open")
Rel(cont_report_svc, sys_fs, "Writes/reads cache under PathManager.getSystemDir()/milkyway/<hash>/")

SHOW_LEGEND()
@enduml
