@startuml c4-sequence-analytics
title C4 — Sequence: AnalysisPipeline.run(graph) + CytoscapeVisualizer.render()

participant "GradleDependency\nAnalysisRunner" as runner
participant "AnalysisPipeline" as pipeline
participant "CriticalPathAnalyzer" as cpa
participant "TarjanSccFinder" as scc
participant "ArticulationPoints\nAnalyzer" as apa
participant "GraphShapeMatcher" as gsm
participant "ShapeMatcher" as sm
participant "ShapeManager" as smgr
participant "GraphAnalysisResult" as gar
participant "CytoscapeVisualizer" as vis
participant "MilkyWaySettings" as settings
participant "CytoscapeReportDto" as dto

runner -> pipeline : run(graph)  [runBlocking]
activate pipeline

note over pipeline
  coroutineScope { analyzers.map { async { it.analyze(graph) } }.awaitAll() }
  — all three analyzers run concurrently
end note

pipeline -> cpa : async { analyze(graph) }
activate cpa
cpa -> scc : find()
activate scc
scc -> scc : Tarjan (indexMap, lowLinkMap, stack)
scc --> cpa : List<StronglyConnectedComponent>
deactivate scc
cpa -> cpa : condenseGraph(graph) → CondensedGraph (DAG, internal)
cpa -> cpa : topological sort + longest-path DP
cpa -> cpa : restore all paths (predecessors)
cpa --> pipeline : CriticalPathResult\n(longestPathLength, expandedPaths)
deactivate cpa

pipeline -> apa : async { analyze(graph) }
activate apa
apa -> apa : build undirected neighbour map from adjacency
apa -> apa : iterative DFS (tin, low, childrenCount per component)
apa --> pipeline : ArticulationPointsResult(points: Set<Node>)
deactivate apa

pipeline -> gsm : async { analyze(graph) }
activate gsm
gsm -> gsm : asAcyclic() — DFS breaks back edges
gsm -> gsm : buildLayerProfile(dag)\n(out-degree topo from sinks → counts per layer)
gsm -> sm : calculate(layerProfile)
activate sm
loop for each Shape in [TRIANGLE, INVERSE_TRIANGLE, RECTANGLE, RHOMBUS, MIDDLE_BOTTLENECK]
    sm -> sm : shape.getBaseProfile(targetLength=32)
    sm -> smgr : similarityPercent(profile, base, 32)
    smgr -> smgr : resampleLinear + normalize + cosineSimilarity
    smgr --> sm : percent
end
sm --> gsm : Map<Shape, Double>
deactivate sm
gsm --> pipeline : ShapeMatchResult(similarities: Map<Shape, Double>)
deactivate gsm

pipeline -> gar : GraphAnalysisResult(graph, mapOf(KClass → result))
pipeline --> runner : GraphAnalysisResult
deactivate pipeline

runner -> settings : read state → CytoscapePluginSettingsDto
runner -> vis : CytoscapeVisualizer(pluginSettings).render(analysisResult)
activate vis
vis -> gar : get(CriticalPathResult::class)
vis -> gar : get(ArticulationPointsResult::class)
vis -> gar : get(ShapeMatchResult::class)
vis -> vis : compute critical nodes / edges (expandedPaths + adjacency)
vis -> vis : distinct modules sorted by id
vis -> vis : group modules by 'prefix before :' → CytoscapeGroupDto
vis -> vis : build CytoscapeElementDto: nodes / edges / group nodes
vis -> dto : new CytoscapeReportDto(summary, elements, criticalPaths, groups, shapeSimilarities, pluginSettings)
vis -> vis : Json.encodeToString(dto)
vis -> vis : loadResource("/web/cytoscape.html") etc.\nreplace {{MILKYWAY_*}} placeholders
vis --> runner : VisualizationOutput.Browser.Html(content)
deactivate vis

note over vis,dto
  Ordering is deterministic:
  modules sorted by id, edges by (source, target),
  groups by id — so cached HTML diffs cleanly.
end note

@enduml
